# 줄바꿈 정규화 — 저장소에는 항상 LF 로 담는다.
# 셸 스크립트가 CRLF 로 체크아웃되면 macOS/Linux 에서
# "bad interpreter: /usr/bin/env bash^M" 로 실행이 안 된다.
* text=auto eol=lf

# 확실히 LF 여야 하는 것들
*.sh    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf

# Windows 전용 스크립트는 CRLF 가 안전하다
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# 바이너리
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff  binary
*.woff2 binary
